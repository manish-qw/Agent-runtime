# AgentOS Environment Variables

# --- GEMINI MODEL CONFIGURATION ---
# Universally used by all agents
GEMINI_MODEL_NAME=gemini-2.5-flash

# --- VERTEX AI (GOOGLE CLOUD) CREDENTIALS ---
# If you are using Vertex AI, provide your Google Cloud Project ID and Location.
# The SDK will automatically detect these and use Vertex AI instead of the standard Developer API.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- STANDARD GEMINI API CREDENTIALS ---
# If you are NOT using Vertex AI and just using the standard Gemini Developer API,
# provide your API key here (and leave the Google Cloud variables blank).
GEMINI_API_KEY=your-gemini-api-key
